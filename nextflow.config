manifest {
    name        = 'MAGFlow'
    version     = '1.0.0'
    author      = 'Hassan Afrad'
    homePage    = 'https://github.com/hassanafrad/MAGFlow'
    description = 'A modular workflow for metagenome-assembled genome (MAG) reconstruction from Illumina metagenomic sequencing data.'
}

params {
    metadata    = 'input/metadata.csv'
    fastq_dir   = '/data/pam/ha7g/scratch/projects/metagenomics/CATI/fastq'

    scratch = System.getenv('NXF_WORK') ?: '/data/pam/ha7g/scratch/projects/metagenomics/CATI/MAGFlow_work'
    outdir = System.getenv('MAGFLOW_OUTDIR') ?: '/data/pam/ha7g/scratch/projects/metagenomics/CATI/MAGFlow_results'

    use_trimmed_reads = false

    max_cpus    = 32
    max_memory  = '128 GB'
    max_time    = '48h'

    kraken2_db = '/data/pam/ha7g/scratch/databases/kraken2_standard'

    assembler   = 'metaspades'
    host_removal = 'bowtie2'

    dastool_score_threshold = 0.5

    /*
    * CoverM abundance metrics
    */
    coverm_methods = [
        'relative_abundance',
        'mean',
        'covered_fraction'
    ]

    coverm_min_covered_fraction = 10
}

workDir = params.scratch

includeConfig 'conf/references.config'

profiles {

    farm22 {
        includeConfig 'conf/farm22.config'
    }

    test {
        includeConfig 'conf/farm22.config'
    }
}