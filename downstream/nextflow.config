manifest {
    name = 'MAGFlow CATI downstream feature analyses'
    version = '0.2.0'
    description = 'Incremental standalone AMR, virulence, functional and MAG genome-comparison workflow.'
}

params {
    input = null
    all_input = null
    outdir = null
    batch_id = null
    work_dir = null
    amrfinder_db = null
    amrfinder_db_fingerprint = ''
    vfdb_db = null
    vfdb_db_fingerprint = ''
    eggnog_data = null
    eggnog_db_fingerprint = ''
    trace_file = null

    vfdb_min_identity = 80
    vfdb_min_query_cover = 70
    vfdb_evalue = '1e-10'
    eggnog_sensitivity = 'sensitive'
    eggnog_options = ''
    amrfinder_organism = ''

}

workDir = params.work_dir ?: "${params.outdir ?: projectDir}/work"

process {
    errorStrategy = 'terminate'
    cpus = 8
    memory = '12 GB'
    time = '4h'

    withName: AMRFINDER {
        cpus = 8
        memory = '12 GB'
        time = '4h'
        conda = "${projectDir}/envs/amrfinder.yml"
    }
    withName: VFDB_SEARCH {
        cpus = 8
        memory = '12 GB'
        time = '4h'
        conda = "${projectDir}/envs/diamond.yml"
    }
    withName: EGGNOG_ANNOTATE {
        cpus = 16
        memory = '48 GB'
        time = '24h'
        conda = "${projectDir}/envs/eggnog.yml"
    }
    withName: STRAIN_FASTANI {
        cpus = 16
        memory = '24 GB'
        time = '24h'
        conda = "${projectDir}/envs/fastani.yml"
    }
    withName: COLLATE_FEATURES {
        cpus = 2
        memory = '3 GB'
        time = '1h'
        conda = "${projectDir}/envs/python.yml"
    }
}

profiles {
    conda { conda.enabled = true }
    farm22 {
        process.executor = 'lsf'
        process.queue = 'normal'
        process {
            withName: AMRFINDER {
                conda = '/data/pam/ha7g/scratch/conda_envs/cati-downstream-amrfinder'
            }
            withName: VFDB_SEARCH {
                conda = '/data/pam/ha7g/scratch/conda_envs/cati-downstream-diamond'
            }
            withName: EGGNOG_ANNOTATE {
                queue = 'long'
                conda = '/data/pam/ha7g/scratch/conda_envs/cati-downstream-eggnog'
            }
            withName: STRAIN_FASTANI {
                queue = 'long'
                conda = '/data/pam/ha7g/scratch/conda_envs/cati-downstream-fastani'
            }
            withName: COLLATE_FEATURES {
                conda = '/data/pam/ha7g/scratch/conda_envs/cati-downstream-python'
            }
        }
    }
}

// Match MAGFlow's Farm22 LSF memory accounting: each request is per job,
// rather than divided across the requested CPU slots.
executor {
    perJobMemLimit = true
    pollInterval = '30 sec'
    queueStatInterval = '30 sec'
    dumpInterval = '5 min'
}

trace {
    enabled = true
    file = params.trace_file ?: "${params.outdir ?: projectDir}/trace.txt"
    overwrite = true
}
