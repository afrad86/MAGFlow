/*
 * ============================================================================
 * MAGFlow
 * Farm22 Configuration
 * ============================================================================
 */

process {
    executor = 'lsf'
    queue = 'long'
    cpus = 16
    memory = '32 GB'
    time = '24h'

    /*
     * Allow individual sample/task failures without
     * aborting unrelated running or pending tasks.
     */
    errorStrategy = 'ignore'

    /*
     * ---------------------------
     * FASTP
     * ---------------------------
     */

    withName: FASTP {

        cpus = 8
        memory = '8 GB'
        time = '1h'

        beforeScript = '''
        module load fastp/0.23.4--hadf994f_2
        '''
    }

    /*
     * ---------------------------
     * Bowtie2 Host Removal
     * ---------------------------
     */

    withName: BOWTIE2_HOST_REMOVAL {
        cpus = 16
        memory = '48 GB'
        time = '4h'

        beforeScript = '''
        module load bowtie2/2.5.1--py38he00c5e5_2
        module load samtools/1.21
        '''
    }
    
    /*
    * ---------------------------
    * Bowtie2 Build Index
    * ---------------------------
    */

    withName: BOWTIE2_BUILD_INDEX {

        cpus = 4
        memory = '8 GB'
        time = '2h'

        beforeScript = '''
        module load bowtie2/2.5.1--py38he00c5e5_2
        '''
    }

    /*
    * ---------------------------
    * Bowtie2 Mapping
    * ---------------------------
    */

    withName: BOWTIE2_MAP {

        cpus = 16
        memory = '48 GB'
        time = '6h'

        beforeScript = '''
        module load bowtie2/2.5.1--py38he00c5e5_2
        module load samtools/1.21
        '''
    }

    /*
    * ---------------------------
    * Kraken2
    * ---------------------------
    */

    withName: KRAKEN2 {

        cpus = 16
        memory = '128 GB'
        time = '2h'

        beforeScript = '''
        module load kraken2/2.1.2
        '''
    }

    /*
    * ---------------------------
    * Bracken
    * ---------------------------
    */

    withName: BRACKEN {

        cpus = 2
        memory = '8 GB'
        time = '1h'

        beforeScript = '''
        module load bracken/2.6.2
        '''
    }

    /*
     * ---------------------------
     * metaSPAdes Assembly
     * ---------------------------
     */

    withName: METASPADES {

        cpus = 32
        memory = '128 GB'
        time = '12h'

        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries = 2

        beforeScript = '''
        module load spades/4.1.0
        '''
    }

    /*
    * ---------------------------
    * MetaBAT2
    * ---------------------------
    */

    withName: METABAT2 {

        cpus = 4
        memory = '12 GB'
        time = '1h'

        beforeScript = '''
        module load PaM/environment
        module load metabat2/2.15--h4da6f23_2
        '''
    }

    /*
    * ---------------------------
    * CONCOCT
    * ---------------------------
    */

    withName: CONCOCT {

        cpus = 2
        memory = '16 GB'
        time = '6h'

        beforeScript = '''
        module load PaM/environment
        module load concoct/1.1.0--py311h245ed52_4
        '''
    }

    /*
    * ---------------------------
    * MAXBIN2
    * ---------------------------
    */

    withName: MAXBIN2 {

        cpus = 16
        memory = '8 GB'
        time = '4h'

        beforeScript = '''
        module load ISG/conda
        source $(conda info --base)/etc/profile.d/conda.sh
        conda activate /data/pam/ha7g/scratch/conda_envs/magflow-binning
        '''
    }

    /*
    * ---------------------------
    * DAS Tool
    * ---------------------------
    */

    withName: DASTOOL {

        cpus = 16
        memory = '24 GB'
        time = '1h'

        beforeScript = '''
        module load PaM/environment
        module load das_tool/1.1.7--r43hdfd78af_0
        '''
    }

    withName: CHECKM2 {

        cpus = 16
        memory = '32 GB'
        time = '1h'
            
        beforeScript = '''
        module load checkm2/1.0.1--pyh7cba7a3_0
        '''
    }

    withName: GTDBTK {

        cpus = 4
        memory = '256 GB'
        time = '4h'

        beforeScript = '''
        module load gtdbtk/2.7.1
        '''
    }

    /*
     * ---------------------------
     * Prokka
     * ---------------------------
     */

    withName: PROKKA {

        cpus = 8
        memory = '24 GB'
        time = '6h'

        beforeScript = '''
        module load prokka/1.14.5-c2
        '''
    }

    withName: COVERM {

        cpus = 8
        memory = '16 GB'
        time = '4h'

        beforeScript = '''
        module load ISG/conda
        source $(conda info --base)/etc/profile.d/conda.sh
        conda activate /data/pam/ha7g/scratch/conda_envs/coverm
        '''
    }
}

/*
 * ============================================================================
 * LSF Executor
 * ============================================================================
 */

executor {

    perJobMemLimit = true

    pollInterval = '30 sec'
    queueStatInterval = '30 sec'
    dumpInterval = '5 min'

}
